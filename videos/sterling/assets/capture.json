  "heads": [
    {
      "tag": "H1",
      "text": "The model you pay for. From a verified provider.",
      "font": "\"Zalando Sans Expanded\", \"Public Sans Variable\", \"Public Sans\", \"PingFang SC\", \"Microsoft YaHei\", sans-serif",
      "size": "36px",
      "weight": "500",
      "color": "rgb(255, 255, 255)"
    },
    {
      "tag": "H2",
      "text": "Three steps. Then the verified model.",
      "font": "\"Public Sans Variable\", \"Public Sans\", \"PingFang SC\", \"Microsoft YaHei\", sans-serif",
      "size": "24px",
      "weight": "500",
      "color": "rgb(27, 37, 32)"
    },
    {
      "tag": "H2",
      "text": "Routed only to providers that are verified.",
      "font": "\"Zalando Sans Expanded\", \"Public Sans Variable\", \"Public Sans\", \"PingFang SC\", \"Microsoft YaHei\", sans-serif",
      "size": "48px",
      "weight": "500",
      "color": "rgb(17, 17, 17)"
    },
    {
      "tag": "H3",
      "text": "Model identity",
      "font": "\"Zalando Sans Expanded\", \"Public Sans Variable\", \"Public Sans\", \"PingFang SC\", \"Microsoft YaHei\", sans-serif",
      "size": "18px",
      "weight": "500",
      "color": "rgb(17, 17, 17)"
    },
    {
      "tag": "H3",
      "text": "Tool calls",
      "font": "\"Zalando Sans Expanded\", \"Public Sans Variable\", \"Public Sans\", \"PingFang SC\", \"Microsoft YaHei\", sans-serif",
      "size": "18px",
      "weight": "500",
      "color": "rgb(17, 17, 17)"
    },
    {
      "tag": "H3",
      "text": "Parameters honoured",
      "font": "\"Zalando Sans Expanded\", \"Public Sans Variable\", \"Public Sans\", \"PingFang SC\", \"Microsoft YaHei\", sans-serif",
      "size": "18px",
      "weight": "500",
      "color": "rgb(17, 17, 17)"
    },
    {
      "tag": "H3",
      "text": "Silent failures",
      "font": "\"Zalando Sans Expanded\", \"Public Sans Variable\", \"Public Sans\", \"PingFang SC\", \"Microsoft YaHei\", sans-serif",
      "size": "18px",
      "weight": "500",
      "color": "rgb(17, 17, 17)"
    },
    {
      "tag": "H3",
      "text": "Declared context",
      "font": "\"Zalando Sans Expanded\", \"Public Sans Variable\", \"Public Sans\", \"PingFang SC\", \"Microsoft YaHei\", sans-serif",
      "size": "18px",
      "weight": "500",
      "color": "rgb(17, 17, 17)"
    },
    {
      "tag": "H2",
      "text": "Three steps. Then you're in.",
      "font": "\"Zalando Sans Expanded\", \"Public Sans Variable\", \"Public Sans\", \"PingFang SC\", \"Microsoft YaHei\", sans-serif",
      "size": "48px",
      "weight": "500",
      "color": "rgb(17, 17, 17)"
    },
    {
      "tag": "H3",
      "text": "Create your key.",
      "font": "\"Zalando Sans Expanded\", \"Public Sans Variable\", \"Public Sans\", \"PingFang SC\", \"Microsoft YaHei\", sans-serif",
      "size": "20px",
      "weight": "500",
      "color": "rgb(17, 17, 17)"
    },
    {
      "tag": "H3",
      "text": "Add credit.",
      "font": "\"Zalando Sans Expanded\", \"Public Sans Variable\", \"Public Sans\", \"PingFang SC\", \"Microsoft YaHei\", sans-serif",
      "size": "20px",
      "weight": "500",
      "color": "rgb(17, 17, 17)"
    },
    {
      "tag": "H3",
      "text": "Plug into your app.",
      "font": "\"Zalando Sans Expanded\", \"Public Sans Variable\", \"Public Sans\", \"PingFang SC\", \"Microsoft YaHei\", sans-serif",
      "size": "20px",
      "weight": "500",
      "color": "rgb(17, 17, 17)"
    },
    {
      "tag": "H2",
      "text": "Change the endpoint. Keep your workflow.",
      "font": "\"Zalando Sans Expanded\", \"Public Sans Variable\", \"Public Sans\", \"PingFang SC\", \"Microsoft YaHei\", sans-serif",
      "size": "48px",
      "weight": "500",
      "color": "rgb(17, 17, 17)"
    },
    {
      "tag": "H2",
      "text": "Built on Mira Network",
      "font": "\"Zalando Sans Expanded\", \"Public Sans Variable\", \"Public Sans\", \"PingFang SC\", \"Microsoft YaHei\", sans-serif",
      "size": "48px",
      "weight": "500",
      "color": "rgb(17, 17, 17)"
    }
